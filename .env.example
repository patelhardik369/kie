# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Get one at https://kie.ai/api-key
# Server-side only — there is deliberately no NEXT_PUBLIC_ variant.
KIE_API_KEY=

# Where generated outputs are written.
# Defaults to a kie-studio SUBFOLDER so output does not mix into the flat
# generations/ directory that the /generate skill and its gallery.html scan.
KIE_OUTPUT_DIR=C:/Users/Hardik/generations/kie-studio

# SQLite database file.
DATABASE_URL=file:./data/kie.db

# Optional. Leave EMPTY for local development.
# Kie cannot reach localhost, so webhooks stay off and the poller handles
# completion. Set this to a public origin (deploy or tunnel) to enable
# callBackUrl delivery at <KIE_PUBLIC_URL>/api/kie/webhook.
KIE_PUBLIC_URL=

# Required only when KIE_PUBLIC_URL is set. The HMAC key Kie signs callbacks
# with; used to verify X-Webhook-Signature.
KIE_WEBHOOK_HMAC_KEY=
