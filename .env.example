# Copy to .env and fill in. .env is gitignored and must never be committed.
# On Vercel these go in Project Settings → Environment Variables instead.
#
# There is no API key here. Each user adds their own Kie key in the app's
# Settings page; it is stored in their browser and billed to their own account.
# See docs/DEPLOYMENT.md for the full walkthrough.


# ── Supabase ──────────────────────────────────────────────────────────────

# Settings → Database → Connection string → Transaction pooler (port 6543).
#
# 6543, not 5432. Every serverless invocation is its own process with its own
# pool, and the direct connection runs out of slots long before the function
# concurrency does. The app detects :6543 and turns off prepared statements,
# which that pool mode requires.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Settings → Data API → Project URL
SUPABASE_URL=https://<ref>.supabase.co

# Settings → API keys → service_role.
#
# Bypasses row-level security entirely, which is why it is server-side only and
# why every query in this app scopes itself by hand.
SUPABASE_SERVICE_ROLE_KEY=


# ── Secrets ───────────────────────────────────────────────────────────────

# 32 random bytes, base64. Seals a user's API key while their generation runs,
# and signs the capability token on every asset URL.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# The bearer token /api/jobs/tick demands. Nothing finishes without a scheduled
# call to that endpoint — docs/DEPLOYMENT.md §4.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ── Storage ───────────────────────────────────────────────────────────────
# Defaults below are correct for Supabase Free.

SUPABASE_STORAGE_BUCKET=kie-outputs

# Supabase Free caps every object at 50 MB and the limit is not raisable on that
# plan. An output larger than this is recorded as `too_large` with its Kie link
# kept, rather than failing the generation.
MAX_STORAGE_FILE_BYTES=52428800

# Supabase Free gives 1 GB total. Generations are refused before submission once
# this is reached, so nothing is ever paid for and then discarded.
STORAGE_QUOTA_BYTES=1073741824


# ── Webhooks — single-user deployments only ───────────────────────────────
#
# Leave both empty unless you are the only person using this deployment.
#
# A callback merely brings the next poll forward; the scheduled tick completes
# every generation without one. So the upside is a few seconds of latency.
#
# The downside on a shared deployment is real: Kie issues the HMAC key per
# ACCOUNT (kie.ai/settings) and signs each callback with the key of whoever
# submitted the task. This server holds exactly one. Callbacks from any other
# account fail verification, answer 401, and are retried by Kie.

# Your deployed origin, e.g. https://kie-studio.vercel.app (no trailing slash).
KIE_PUBLIC_URL=

# kie.ai/settings → webhookHmacKey. Required only when KIE_PUBLIC_URL is set;
# setting the URL without it is a startup error, deliberately — an
# unverifiable callback is worse than none.
KIE_WEBHOOK_HMAC_KEY=
