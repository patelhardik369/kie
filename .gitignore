# Secrets — never commit.
#
# A blanket `.env*` with one carve-out, rather than a list. The list form fails
# open: the first time someone writes `.env.new`, `.env.staging` or `.env.bak`
# while setting the project up, it is untracked by nothing and one `git add -A`
# away from a public repository. This form fails closed.
.env*
!.env.example

# The legacy local database, kept around only as an import source.
# `npm run db:import` reads it; nothing at runtime does.
data/
*.db
*.db-journal
*.db-wal

# Outputs used to be written here. They now live in Supabase Storage, but a
# local override or a leftover folder should still never be committed.
# Anchored with a leading slash: unanchored, `generations/` also matched
# app/api/generations/, and quietly kept that route out of the repository.
/output/
/generations/

# Dependencies and build
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.vercel/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (project conventions in .claude/ ARE committed)
.claude/settings.local.json

# Screenshot / browser-automation artifacts
.playwright-mcp/
*.png
